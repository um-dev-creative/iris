{
  "name": "dashboard",
  "version": "0.0.0",
  "main": "server.js",
  "scripts": {
    "ng": "ng",
    "prepare": "git config core.hooksPath .githooks",
    "start": "ng serve",
    "build": "cross-env ng build --configuration=$ENVM",
    "build:dev": "ng build --configuration development",
    "build:ssr": "cross-env-shell \"ng build --configuration $ENVM && ng run dashboard:server\"",
    "watch": "ng build --watch --configuration development",
    "watch:ssr": "ng run dashboard:server:development --watch",
    "serve:integrated": "pnpm run build:ssr && node server.js",
    "dev:integrated:unix": "concurrently \"pnpm run watch:ssr\" \"sleep 5 && node server.js\"",
    "dev:integrated:win": "concurrently \"pnpm run watch:ssr\" \"timeout 5 && node server.js\"",
    "server": "node server.js",
    "test": "ng test --code-coverage --no-watch --browsers ChromeHeadlessNoSandbox",
    "test:browser": "ng test --code-coverage",
    "test:bff": "node --test server/test/*.test.js",
    "test:bff:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 --test-coverage-include='server/**' --test-coverage-exclude='server/test/**' server/test/*.test.js"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "axios": "^1.13.6",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "js-yaml": "^4.1.1",
    "lucide-angular": "^0.575.0",
    "multer": "^2.1.1 ",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "winston": "^3.8.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^7.6.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.2.0",
    "typescript": "~6.0.0"
  }
}
