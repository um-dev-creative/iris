{
  "name": "dashboard",
  "version": "0.0.0",
  "main": "server.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "cross-env ng build --configuration=$ENVM",
    "build:dev": "ng build --configuration development",
    "build:ssr": "cross-env-shell \"ng build --configuration $ENVM && ng run dashboard:server\"",
    "watch": "ng build --watch --configuration development",
    "watch:ssr": "ng run dashboard:server:development --watch",
    "serve:integrated": "pnpm run build:ssr && node server.js",
    "dev:integrated:unix": "concurrently \"pnpm run watch:ssr\" \"sleep 5 && node server.js\"",
    "dev:integrated:win": "concurrently \"pnpm run watch:ssr\" \"timeout 5 && node server.js\"",
    "server": "node server.js",
    "start-dev:unix": "node server.js --vaultToken $VAULT_TOKEN --vaultUrl $VAULT_URL --vaultPath UMDC/data/iris/$ENVM --debugMode $DEBUG_MODE",
    "start-dev:win": "node server.js --vaultToken %VAULT_TOKEN% --vaultUrl %VAULT_URL% --vaultPath UMDC/data/iris/%ENVM% --debugMode %DEBUG_MODE%",
    "test": "ng test --code-coverage --no-watch --browsers ChromeHeadlessNoSandbox",
    "test:browser": "ng test --code-coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@angular/platform-browser": "^21.2.4",
    "@angular/platform-browser-dynamic": "^21.2.4",
    "@angular/platform-server": "^21.2.4",
    "@angular/router": "^21.2.4",
    "@angular/ssr": "^21.2.3",
    "agentkeepalive": "^4.6.0",
    "axios": "^1.13.6",
    "compression": "^1.7.4",
    "config": "^3.3.9",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "multer": "^2.1.1 ",
    "dotenv": "^16.0.3",
    "express": "^4.22.1",
    "express-http-context": "^1.2.4",
    "express-rate-limit": "^8.3.1",
    "geist": "^1.7.0",
    "js-yaml": "^4.1.1",
    "logform": "^2.7.0",
    "form-data": "^4.0.5",
    "lucide-angular": "^0.575.0",
    "node-vault-client": "^1.0.2",
    "redis": "^4.7.0",
    "rxjs": "~7.8.0",
    "ajv": "^8.17.1",
    "uuid": "^13.0.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "winston": "^3.8.2",
    "yargs": "^17.7.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.4",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^7.6.0",
    "express": "^4.22.1",
    "express-http-context": "^1.2.4",
    "express-rate-limit": "^8.3.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
