{
  "name": "dashboard",
  "version": "0.0.0",
  "main": "server.js",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "start": "ng serve",
    "build": "cross-env ng build --configuration=$ENVM",
    "build:dev": "ng build --configuration development",
    "build:ssr": "cross-env-shell \"ng build --configuration $ENVM && ng run dashboard:server:$ENVM\"",
    "watch": "ng build --watch --configuration development",
    "watch:ssr": "ng run dashboard:server:development --watch",
    "serve:integrated": "pnpm run build:ssr && node server.js",
    "dev:integrated:unix": "concurrently \"pnpm run watch:ssr\" \"sleep 5 && node server.js\"",
    "dev:integrated:win": "concurrently \"pnpm run watch:ssr\" \"timeout 5 && node server.js\"",
    "server": "node server.js",
    "test": "ng test --no-watch --coverage",
    "test:watch": "ng test --watch",
    "test:server": "vitest run --config vitest.server.config.mjs --coverage",
    "test:all": "pnpm test:server && pnpm test",
    "coverage:merge": "node scripts/merge-coverage.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "axios": "^1.13.6",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "js-yaml": "^4.1.1",
    "lucide-angular": "^0.575.0",
    "multer": "^2.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "winston": "^3.8.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^7.6.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.2.0",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  }
}
