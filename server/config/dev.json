{
  "ssl": {
    "enabled": true,
    "certificateType": "backbone"
  },
  "mercuryProxyConfig": [
    {
      "applicationName": "mercury",
      "matchOn": {
        "startWith": "/mrc/api/v1/general"
      },
      "urlRewrite": {
        "from": "/mrc/api/v1/general",
        "to": "/mercury/api/v1"
      }
    }
  ],
  "mercuryAuthProxyConfig": [
    {
      "applicationName": "mercury",
      "matchOn": {
        "startWith": "/mrc/api/v1/auth/access-token"
      },
      "urlRewrite": {
        "from": "/mrc/api/v1/auth/access-token",
        "to": "/mercury/api/v1/auth/session-token"
      }
    }
  ],
  "mercuryUserProfileImageProxyConfig": [
    {
      "applicationName": "mercury",
      "matchOn": {
        "startWith": "/mrc/api/v1/d-image/users/profile"
      },
      "urlRewrite": {
        "from": "/mrc/api/v1/d-image/users/profile",
        "to": "/mercury/api/v1/profile/image"
      }
    }
  ],
  "mercuryCreateUserProxyConfig": [
    {
      "applicationName": "mercury",
      "matchOn": {
        "startWith": "/mrc/api/v1/auth/create-user"
      },
      "urlRewrite": {
        "from": "/mrc/api/v1/auth/create-user",
        "to": "/mercury/api/v1/users"
      }
    }
  ],
  "mercuryVerifyCodeProxyConfig": [
    {
      "applicationName": "mercury",
      "matchOn": {
        "startWith": "/mrc/api/v1/auth/verify-code"
      },
      "urlRewrite": {
        "from": "/mrc/api/v1/auth/verify-code",
        "to": "/mercury/api/v1/user-register"
      }
    }
  ],
  "backboneProxyConfig": [
    {
      "applicationName": "backbone",
      "matchOn": {
        "startWith": "/bkd/api/v1"
      },
      "urlRewrite": {
        "from": "/bkd/api/v1",
        "to": "/backbone/api/v1"
      }
    }
  ]
}
