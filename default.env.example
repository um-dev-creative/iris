# Copia este archivo a default.env (o .env) y completa los valores. NO commitear default.env ni .env.
# El BFF (server.js) lee estas variables con dotenv; todas tienen valor por defecto para desarrollo local.

# Entorno de build de Angular: development|dev|qa|dev-cloud|qa-cloud|production (ver docs/technical/environments.md)
ENVM=development
# production exige BACKBONE_APPLICATION_ID, BACKBONE_CLIENT_ID y BACKBONE_CLIENT_SECRET
NODE_ENV=development
# Puerto del BFF (sirve la app Angular y las APIs)
PORT=4000

# Servicios aguas arriba (gateway) y raíz de cada servicio
MERCURY_BASE_URL=http://localhost:8080
MERCURY_API_PREFIX=/mercury/api/v1
BACKBONE_BASE_URL=http://localhost:8443
BACKBONE_API_PREFIX=/backbone/api/v1

# Aplicación Iris registrada en backbone
BACKBONE_APPLICATION_ID=
# Cliente M2M de Iris en backbone; el secreto sale del gestor de secretos, nunca de git
BACKBONE_CLIENT_ID=
BACKBONE_CLIENT_SECRET=
# session:manage inicia sesión; mercury:message:read lee las campañas del dashboard (exigido por Mercury)
BACKBONE_CLIENT_SCOPES=session:manage,mercury:message:read
# Solo desarrollo: aceptar certificados autofirmados de backbone (prohibido en production)
BACKBONE_TLS_INSECURE=false

# Cookies de sesión: true cuando el BFF se sirve por HTTPS
COOKIE_SECURE=false
# Origen permitido por CORS
CORS_ORIGIN=http://localhost:4200
# Proxies delante del BFF (1 detrás de nginx); vacío = ninguno. `true` está prohibido
TRUST_PROXY=
RATE_LIMIT_MAX=1200
LOGIN_RATE_LIMIT_MAX=10
# Trazas W3C hacia mercury y proporción de trazas nuevas muestreadas
TRACING_ENABLED=true
TRACE_SAMPLE_RATE=0.1

# HTTPS opcional: ambas rutas juntas (el certificado va fuera de git, p. ej. en ssl/)
SSL_CERT_PATH=
SSL_KEY_PATH=

# Iris como cliente de login de Mercury: envía y comprueba los códigos de verificación. La contraseña sale del gestor de secretos.
MERCURY_LOGIN_ALIAS=
MERCURY_LOGIN_PASSWORD=

# Registro de usuarios: sin estos valores responde 503. El rol debe ser de solo lectura.
REGISTRATION_ROLE_ID=
REGISTRATION_TEMPLATE_ES=
REGISTRATION_TEMPLATE_EN=
REGISTRATION_MAIL_FROM=

# Monitoreo: aplicación cuyas campañas se muestran (por defecto, BACKBONE_APPLICATION_ID)
MONITORED_APPLICATION_ID=
