# Copia este archivo a default.env y completa los valores. NO commitear default.env.

# Habilita logs de depuración del BFF (true|false)
DEBUG_MODE=false
# Entorno de build/configuración de Angular y del backend (dev|qa|prod|dev-cloud|qa-cloud)
ENVM=dev
# Entorno de ejecución de Node (production desactiva NODE_TLS_REJECT_UNAUTHORIZED=0)
NODE_ENV=dev
# Ruta del secreto en Vault (se concatena como UMDC/data/iris/$ENVM en start-dev)
VAULT_PATH=
# URL base del servidor Vault
VAULT_URL=
# Token de Vault; solicitarlo al equipo de Seguridad/DevOps. Nunca commitear.
VAULT_TOKEN=
