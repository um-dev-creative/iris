# Plantilla de secrets/local.env (ignorado por git: copia este archivo allí). Se aplica después de config/local.env y gana.
# Las credenciales pueden estar aquí o en Vault: deja vacías las que Vault ya tenga.
#
# VAULT_TOKEN: solo con VAULT_ENABLED=true.
# BACKBONE_CLIENT_ID / BACKBONE_CLIENT_SECRET: cliente de aplicación (M2M) de Iris en backbone-rest. Con NODE_ENV=production el
# BFF no arranca sin ellos (código 78). El secreto se muestra una sola vez al registrarlo.
# MERCURY_LOGIN_ALIAS / MERCURY_LOGIN_PASSWORD: Iris como cliente de login de Mercury (códigos de verificación del registro).

VAULT_TOKEN=
BACKBONE_CLIENT_ID=
BACKBONE_CLIENT_SECRET=
MERCURY_LOGIN_ALIAS=
MERCURY_LOGIN_PASSWORD=

# Cualquier otra variable del BFF también puede ir aquí. Sus valores por defecto están en server/config/constants.js:
# MERCURY_BASE_URL=http://localhost:8080
# MERCURY_API_PREFIX=/mercury/api/v1
# BACKBONE_BASE_URL=http://localhost:8443
# BACKBONE_API_PREFIX=/backbone/api/v1
# BACKBONE_TLS_INSECURE=false
# PORT=4000
# CORS_ORIGIN=http://localhost:4200
# TRUST_PROXY=
# RATE_LIMIT_MAX=1200
# LOGIN_RATE_LIMIT_MAX=10
# TRACING_ENABLED=true
# TRACE_SAMPLE_RATE=0.1
# SSL_CERT_PATH=
# SSL_KEY_PATH=
