# Plantilla de secrets/bff.env (ignorado por git: copia este archivo allí y complétalo). Se carga después de config/bff.env,
# así que un valor de este archivo gana. También alimenta el Secret de Kubernetes iris-secrets.
#
# BACKBONE_CLIENT_ID / BACKBONE_CLIENT_SECRET: cliente de aplicación (M2M) de Iris en backbone-rest. Con NODE_ENV=production el
# BFF no arranca sin ellos (código 78). El secreto se muestra una sola vez al registrarlo: guárdalo en el gestor de secretos.
#
# MERCURY_LOGIN_ALIAS / MERCURY_LOGIN_PASSWORD: Iris como cliente de login de Mercury. Envía y comprueba los códigos de
# verificación del registro.
#
# BACKBONE_APPLICATION_ID: solo si config/bff.env lo deja vacío.

BACKBONE_CLIENT_ID=
BACKBONE_CLIENT_SECRET=
MERCURY_LOGIN_ALIAS=
MERCURY_LOGIN_PASSWORD=
# BACKBONE_APPLICATION_ID=
