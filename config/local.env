# Valores no secretos del BFF. Versionado a propósito: nunca pongas aquí una credencial.
# `pnpm start:bff` lo lee y docker compose con env_file. secrets/local.env se aplica después y gana.
# Un valor vacío aquí lo completa Vault cuando VAULT_ENABLED=true. Un valor escrito gana a Vault: no repitas lo que Vault ya tiene.

# Vault: opcional. Con true necesita VAULT_TOKEN (secrets/local.env); si no responde, el BFF no arranca
VAULT_ENABLED=false
VAULT_URI=https://vault.umdc-qa.tst
# Ruta KV v2 con el segmento data, como smartkin-frontend: <backend>/data/<app>/<entorno>
VAULT_PATH=dev/data/iris/qa

# Rutas detrás del gateway: *_BASE_URL ya termina en /mercury y /backbone, así que aquí no se repiten
MERCURY_API_PREFIX=/api/v1
MERCURY_HEALTH_PATH=/actuator/health
BACKBONE_API_PREFIX=/api/v1
# backbone-rest solo publica /actuator/health/liveness y /readiness; /actuator/health exige sesión (401) y se vería "Down"
BACKBONE_HEALTH_PATH=/actuator/health/readiness

# Id de la aplicación Iris en backbone-rest (obligatorio en producción)
BACKBONE_APPLICATION_ID=
# session:manage inicia sesión; mercury:message:read lee las campañas del dashboard; users:manage da de alta y activa
# las cuentas del registro. El cliente M2M debe tener los tres y pertenecer a BACKBONE_APPLICATION_ID
#
# Para CREAR, EDITAR, PAUSAR o ELIMINAR campañas desde Iris, agrega mercury:message:write a la lista (y regístralo antes en el cliente M2M
# de Backbone: pedir un scope no registrado hace que Backbone rechace el token y falle el inicio de sesión). Sin él, Iris solo lee campañas.
BACKBONE_CLIENT_SCOPES=session:manage,mercury:message:read,users:manage

# Iris corre en HTTPS: las cookies de sesión solo viajan por conexión cifrada
COOKIE_SECURE=true

# Certificado del BFF en local, generado por scripts/dev-cert.mjs. docker compose los vacía: ahí nginx termina el TLS
SSL_CERT_PATH=ssl/localhost.crt
SSL_KEY_PATH=ssl/localhost.key

# Registro de usuarios: sin estos valores responde 503. El rol debe ser de solo lectura. Las plantillas son los ids de
# template_defined que imprime scripts/iris/seed-templates.sql en Mercury.
REGISTRATION_ROLE_ID=
REGISTRATION_TEMPLATE_ES=
REGISTRATION_TEMPLATE_EN=
REGISTRATION_MAIL_FROM=

# Aplicación cuyas campañas se muestran y gestionan (por defecto, BACKBONE_APPLICATION_ID)
MONITORED_APPLICATION_ID=
