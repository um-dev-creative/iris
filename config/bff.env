# Valores no secretos del BFF en Docker, cargados por env_file en docker-compose.yml. Versionado a propósito: nunca pongas
# aquí una credencial. Los secretos van en secrets/bff.env, que se carga después y por eso gana. PORT, NODE_ENV y TRUST_PROXY
# los fija docker-compose.yml. Completa los valores vacíos para tu entorno.

# Mercury y backbone-rest en la red nginx_umdc-net, sin gateway: la raíz de cada API es /api/v1
MERCURY_BASE_URL=https://mercury:8118
MERCURY_API_PREFIX=/api/v1
MERCURY_HEALTH_PATH=/actuator/health
BACKBONE_BASE_URL=https://backbone-rest:8084
BACKBONE_API_PREFIX=/api/v1
BACKBONE_HEALTH_PATH=/actuator/health

# Id de la aplicación Iris en backbone-rest (obligatorio). Complétalo aquí o en secrets/bff.env
BACKBONE_APPLICATION_ID=
# session:manage inicia sesión; mercury:message:read lee las campañas del dashboard
BACKBONE_CLIENT_SCOPES=session:manage,mercury:message:read

# true detrás de HTTPS; false solo para una ejecución local por HTTP
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

# Registro de usuarios: sin estos valores responde 503. El rol debe ser de solo lectura. Las plantillas son los ids de
# template_defined que imprime scripts/iris/seed-templates.sql en Mercury.
REGISTRATION_ROLE_ID=
REGISTRATION_TEMPLATE_ES=
REGISTRATION_TEMPLATE_EN=
REGISTRATION_MAIL_FROM=

# Aplicación cuyas campañas se muestran (por defecto, BACKBONE_APPLICATION_ID)
MONITORED_APPLICATION_ID=
